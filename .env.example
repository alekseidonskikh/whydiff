# Copy to .env (cp .env.example .env). Read by make, VS Code and your shell.

# Host ports of the Docker databases
WHYDIFF_PG_PORT=5433
WHYDIFF_CH_HTTP_PORT=18123
WHYDIFF_CH_NATIVE_PORT=19000

# Demo database (tables orders, orders_v2)
WHYDIFF_PG_URI=postgresql://whydiff:whydiff@localhost:5433/whydiff

# Database used by pytest; Postgres tests are skipped when this is unset
WHYDIFF_TEST_PG_URI=postgresql://whydiff:whydiff@localhost:5433/whydiff_test
